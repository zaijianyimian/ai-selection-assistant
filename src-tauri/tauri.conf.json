{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Selection Assistant",
  "version": "0.1.1",
  "identifier": "io.github.ai-selection-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AI Selection Assistant", "width": 1100, "height": 800, "minWidth": 720, "minHeight": 580 },
      { "label": "translation", "title": "划词翻译 · AI Selection Assistant", "url": "index.html?window=translation", "width": 540, "height": 740, "minWidth": 390, "minHeight": 420, "visible": false, "alwaysOnTop": true }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"], "shortDescription": "AI selection translation with contextual technical terms", "category": "Productivity", "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } }, "linux": { "deb": { "depends": ["wl-clipboard", "fonts-noto-cjk"] } } }
}
